{
  "project": {
    "name": "@cardor/rn-firebase-cli",
    "description": "a CLI lib to manage react native FB projects and build workflows",
    "docsPath": "./docs"
  },
  "provider": "opencode",
  "database": {
    "type": "sqlite"
  },
  "storage": {
    "dir": ".harness",
    "tasks": {
      "adapter": "local"
    },
    "sections": {
      "toolsUsed": true,
      "filesModified": true,
      "result": true,
      "blockers": true,
      "nextSteps": false
    },
    "markdownFallback": {
      "enabled": true
    },
    "scope": "global",
    "projectId": "944a275c-219b-4eb3-8c78-516f2a5ac730"
  },
  "health": {
    "scriptPath": "./health.sh",
    "required": true
  },
  "tools": {
    "mcp": {
      "enabled": true,
      "port": 3742
    },
    "scripts": {
      "enabled": true,
      "outputDir": "./.harness/scripts"
    }
  }
}
